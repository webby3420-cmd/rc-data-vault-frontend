# Sentry DSN for the browser bundle (public; client errors) — TODO: add before first user
NEXT_PUBLIC_SENTRY_DSN=
# Sentry DSN for server/edge runtimes (falls back to NEXT_PUBLIC_SENTRY_DSN when unset)
SENTRY_DSN=
# PostHog project API key (public; separate PostHog project from canopy-app) — TODO: add before first user
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog ingestion host (US cloud default)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
